+      ['**/*.js', '^(?:(?:(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/)?(?!\\.)(?=.)[^/]*?\\.js\\/?)$'],
+      ['src/**/*.{js,ts}', '^(?:src(?:\\/(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/|\\/|$)(?!\\.)(?=.)[^/]*?\\.(js|ts))$'],
+      ['!**/node_modules/**', '^(?!^(?:(?:^|\\/|(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/)node_modules(?:\\/(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)|$))$).*$'],
+      ['**/*.test.ts', '^(?:(?:(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/)?(?!\\.)(?=.)[^/]*?\\.test\\.ts\\/?)$'],
+      ['**/__tests__/**/*.[jt]s?(x)', '^(?:(?:^|\\/|(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/)__tests__(?:\\/(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/|\\/|$)(?!\\.)(?=.)[^/]*?\\.(?:\\[jt\\]|[jt])s(?:x)?)$'],
+      ['**/?(*.)+(spec|test).[jt]s?(x)', '^(?:(?:^|\\/|(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/)(?:[^/]*?\\.)?(?:spec|test)+\\.(?:\\[jt\\]|[jt])s(?:x)?)$'],
+      ['a/**/b/**/c', '^(?:a(?:\\/(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/|\\/|$)b(?:\\/(?!\\.)(?:(?:(?!(?:^|\\/)\\.)[\\s\\S])*?)\\/|\\/|$)c)$'],
+      ['[abc]*.md', '^(?:(?:\\[abc\\]|[abc])[^/]*?\\.md)$'],
+      ['[!a]*', '^(?:[^a/][^/]*?\\/?)$'],
+      ['foo/{bar,baz}/*.txt', '^(?:foo\\/(bar|baz)\\/(?!\\.)(?=.)[^/]*?\\.txt)$'],
+      ['+(abc)', '^(?:(?=.)(?:abc)+)$'],
+      ['*(foo|bar)', '^(?:(?=.)(?:foo|bar)*)$'],
